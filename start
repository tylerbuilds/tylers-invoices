#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
umask 077
if [[ ! -x .venv/bin/python ]]; then
  python3 -m venv .venv
  .venv/bin/python -m pip install -r requirements.txt
fi
if [[ "${1:-}" == "--setup-only" ]]; then
  exec .venv/bin/python invoices.py doctor
fi
exec .venv/bin/python server.py
