{
  "id": "tylers-invoices",
  "name": "Tyler's invoices",
  "description": "Local invoice PDFs, drafts, imports and Obsidian. No shell commands or email sending.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "projectPath",
      "dataDirectory",
      "allowedAgentIds"
    ],
    "properties": {
      "projectPath": {
        "type": "string",
        "minLength": 1
      },
      "dataDirectory": {
        "type": "string",
        "minLength": 1
      },
      "allowedAgentIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  },
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "tylers_invoices"
    ]
  },
  "toolMetadata": {
    "tylers_invoices": {
      "profiles": [
        "coding"
      ]
    }
  }
}
